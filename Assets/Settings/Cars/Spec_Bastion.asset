  DisplayName: "\u0411\u0430\u0441\u0442\u0438\u043E\u043D"
  Description: "\u0420\u043E\u0441\u043A\u043E\u0448\u043D\u044B\u0439 \u0440\u0430\u043C\u043D\u044B\u0439 \u0432\u043D\u0435\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A: \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u0432\u044B\u0441\u043E\u043A\u0438\u0439, \u0441 \u043C\u043E\u0449\u043D\u044B\u043C \u0431\u0438\u0442\u0443\u0440\u0431\u043E-\u043C\u043E\u0442\u043E\u0440\u043E\u043C. \u041D\u0435 \u0431\u043E\u0438\u0442\u0441\u044F \u0433\u0440\u0443\u043D\u0442\u0430 \u0438 \u043F\u0435\u0441\u043A\u0430, \u043D\u043E \u0432 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430\u0445 \u043A\u0440\u0435\u043D\u0438\u0442\u0441\u044F \u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0440\u0435\u0437\u043A\u0438\u0445 \u043C\u0430\u043D\u0451\u0432\u0440\u043E\u0432."
